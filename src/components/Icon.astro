---
// SVG-Icons werden beim Build eingebettet (Lucide, ISC-Lizenz; WhatsApp-Logo aus Simple Icons, CC0).
// Keine Emojis, kein Icon-Font, kein Request zur Laufzeit.
import fs from 'node:fs';
import path from 'node:path';

interface Props { name: string; size?: number; class?: string; label?: string; strokeWidth?: number }
const { name, size = 24, class: cls = '', label, strokeWidth = 2 } = Astro.props;

const root = process.cwd();
let inner = '';
let viewBox = '0 0 24 24';
let brand = false;
if (name === 'whatsapp') {
  const raw = fs.readFileSync(path.join(root, 'node_modules/simple-icons/icons/whatsapp.svg'), 'utf8');
  inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<title>.*?<\/title>/, '');
  brand = true;
} else {
  const raw = fs.readFileSync(path.join(root, `node_modules/lucide-static/icons/${name}.svg`), 'utf8');
  inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<!--[\s\S]*?-->/g, '');
}
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---
{brand ? (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} width={size} height={size} fill="currentColor" class={`icon ${cls}`} {...a11y} set:html={inner} />
) : (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} width={size} height={size} fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" class={`icon ${cls}`} {...a11y} set:html={inner} />
)}
