---
import site from '../data/site.config.json';
import Icon from './Icon.astro';
import { telHref } from '../lib/seo';

const nav = [
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/leistungen/flughafentransfer/', label: 'Flughafen' },
  { href: '/leistungen/krankenfahrten/', label: 'Krankenfahrten' },
  { href: '/flotte/', label: 'Flotte' },
  { href: '/tarife/', label: 'Tarife' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/kontakt/', label: 'Kontakt' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/leistungen/' ? path === href : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.firma}, zur Startseite`}>
      <img src="/img/logo.svg" alt="" width="36" height="46" class="brand__logo" />
      <span class="brand__text">
        <span class="brand__name">Insel Taxi</span>
        <span class="brand__sub"><span class="live-dot" aria-hidden="true"></span>24/7 erreichbar</span>
      </span>
    </a>

    <nav class="main-nav" id="hauptnavigation" aria-label="Hauptnavigation" data-nav>
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <div class="main-nav__mobile-cta">
        <a class="btn btn--call btn--block btn--lg" href={telHref}><Icon name="phone" /> {site.telefon.anzeige}</a>
        <p class="muted">Rund um die Uhr erreichbar, 7 Tage die Woche.</p>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--call header-call ring-pulse" href={telHref} data-magnetic>
        <Icon name="phone" size={20} />
        <span class="header-call__text"><span class="sr-only">Anrufen: </span>{site.telefon.anzeige}</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hauptnavigation" data-nav-toggle>
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only">Menü</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, .94);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s, box-shadow .2s;
  }
  .site-header.is-scrolled { border-color: var(--line); box-shadow: 0 6px 24px -18px rgba(23,24,28,.35); }
  .site-header__inner { display: flex; align-items: center; gap: 1rem; min-height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; margin-right: auto; min-height: 48px; }
  .brand__logo { width: 36px; height: 46px; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand__name { font-family: var(--font-heading); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.03em; }
  .brand__sub { display: inline-flex; align-items: center; gap: .4rem; margin-top: .2rem; font-size: .85rem; font-weight: 600; color: var(--ink-3); letter-spacing: .01em; }

  .site-header__actions { display: flex; align-items: center; gap: .6rem; }
  .header-call { min-height: 48px; padding: .6rem 1rem; }
  .header-call__text { display: none; }
  @media (min-width: 420px) { .header-call__text { display: inline; } }

  .nav-toggle {
    width: 48px; height: 48px; display: grid; place-items: center; border-radius: 12px;
    border: 1.5px solid var(--line-strong); background: var(--paper); cursor: pointer; color: var(--ink);
  }
  .nav-toggle__bars { display: grid; gap: 5px; width: 22px; }
  .nav-toggle__bars span { height: 2.5px; background: currentColor; border-radius: 2px; transition: transform .25s var(--ease-out), opacity .2s; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .nav-toggle__bars span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* Mobile Navigation: Panel unter dem Header */
  .main-nav { display: none; }
  .main-nav.is-open {
    display: block; position: fixed; inset: var(--header-h) 0 0 0; background: var(--paper);
    padding: 1rem 20px calc(2rem + env(safe-area-inset-bottom)); overflow-y: auto; border-top: 1px solid var(--line);
  }
  .main-nav ul { list-style: none; margin: 0; padding: 0; }
  .main-nav li { margin: 0; border-bottom: 1px solid var(--line); }
  .main-nav a { display: flex; align-items: center; min-height: 56px; font-family: var(--font-heading); font-weight: 600; font-size: 1.2rem; text-decoration: none; }
  .main-nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 4px; text-underline-offset: 8px; }
  .main-nav__mobile-cta { margin-top: 1.5rem; }
  .main-nav__mobile-cta p { margin-top: .75rem; font-size: 1rem; }

  @media (min-width: 1120px) {
    .nav-toggle { display: none; }
    .main-nav, .main-nav.is-open { display: block; position: static; padding: 0; border: 0; overflow: visible; background: none; }
    .main-nav ul { display: flex; gap: .15rem; }
    .main-nav li { border: 0; }
    .main-nav a { min-height: 44px; padding: 0 .6rem; font-size: .98rem; border-radius: 10px; transition: background-color .15s; }
    .main-nav a:hover { background: var(--mist); }
    .main-nav a[aria-current="page"] { text-underline-offset: 6px; text-decoration-thickness: 3px; }
    .main-nav__mobile-cta { display: none; }
    .brand { margin-right: 0; }
    .main-nav { margin-inline: auto; }
  }
</style>
