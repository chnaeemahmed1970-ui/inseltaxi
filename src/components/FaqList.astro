---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; idPrefix?: string }
const { items, idPrefix = 'faq' } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details class="faq__item" id={`${idPrefix}-${i + 1}`}>
      <summary><span>{it.q}</span><Icon name="plus" size={22} class="faq__icon" /></summary>
      <div class="faq__a"><p set:html={it.a} /></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1.15rem 0; min-height: 56px; font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.05rem, 1rem + .3vw, 1.2rem);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover span { text-decoration: underline; text-decoration-color: var(--yellow-600); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  :global(.faq__icon) { flex: none; width: 36px; height: 36px; padding: 7px; border-radius: 50%; background: var(--yellow-100); transition: transform .3s var(--ease-out), background-color .2s; }
  .faq__item[open] :global(.faq__icon) { transform: rotate(45deg); background: var(--yellow); }
  .faq__a { padding: 0 3rem 1.25rem 0; color: var(--ink-2); }
  .faq__a p { margin: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a { animation: faq-in .3s var(--ease-out); }
    @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } }
  }
</style>
