  <rect x="56" y="1.5" width="18" height="7" rx="2" fill="#FDBE04" stroke="#17181C" stroke-width="1.8" />
  <rect x="59" y="3" width="3" height="2" fill="#17181C" /><rect x="65" y="3" width="3" height="2" fill="#17181C" /><rect x="62" y="5" width="3" height="2" fill="#17181C" /><rect x="68" y="5" width="3" height="2" fill="#17181C" />
